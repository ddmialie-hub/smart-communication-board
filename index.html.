let words = [];
let lastMessage = “”;
let activeCategory = 0;

function renderCategories() {
  const area = document.getElementById(“categories”);
  area.innerHTML = “”;

  categories.forEach((cat, index) => {
    const button = document.createElement(“button”);
    button.className = “cat” +
      (index === activeCategory ? “ active” : “”);
button.textContent = cat.icon + “ “ + cat.name;
    button.setAttribute(“aria-pressed”,
      index === activeCategory ? “true” : “false”);

    button.onclick = () => {
      activeCategory = index;
      renderCategories();
      renderWords();
    };

    area.appendChild(button);
  });
}

function renderWords() {
  const cat = categories[activeCategory];
  document.getElementById(“categoryTitle”).textContent =
    cat.icon + “ “ + cat.name;

  const area = document.getElementById(“words”);
  area.innerHTML = “”;

  cat.words.forEach(item => {
    const button = document.createElement(“button”);
    button.className = “tile”;
    button.setAttribute(“aria-label”, item[1]);

    const symbol = document.createElement(“span”);
    symbol.className = “symbol”;
    symbol.textContent = item[0];

    const label = document.createElement(“span”);
    label.className = “label”;
    label.textContent = item[1];

    button.append(symbol, label);

    button.onclick = () => {
      words.push(item[1]);
      lastMessage = item[1];
      updateSentence();
      document.getElementById(“status”).textContent =
        “Dipilih: “ + item[1];
    };

    area.appendChild(button);
  });
}

function updateSentence() {
  document.getElementById(“sentence”).textContent =
    words.length ? words.join(“ “) :
    “Pilih simbol untuk membina ayat.”;
}

function speakText(text) {
  const status = document.getElementById(“status”);

  if (!text.trim()) {
    status.textContent = “Sila pilih simbol dahulu.”;
    return;
  }

  if (!(“speechSynthesis” in window)) {
    status.textContent =
      “Pelayar ini tidak menyokong fungsi suara.”;
    return;
  }

  window.speechSynthesis.cancel();

  const utterance = new SpeechSynthesisUtterance(text);
  utterance.lang = “ms-MY”;
  utterance.rate = 0.85;

  utterance.onstart = () => {
    status.textContent = “Sedang menyebut mesej...”;
  };

  utterance.onend = () => {
    status.textContent = “Mesej selesai disebut.”;
  };

  utterance.onerror = () => {
    status.textContent =
      “Suara tidak dapat dimainkan. Semak tetapan suara iPad.”;
  };

  window.speechSynthesis.speak(utterance);
}

function speakSentence() {
  speakText(words.join(“ “));
}

function repeatLast() {
  if (words.length) {
    speakText(words.join(“ “));
  } else {
    speakText(lastMessage);
  }
}

function undoWord() {
  words.pop();
  updateSentence();
}

function clearSentence() {
  words = [];
  updateSentence();
  document.getElementById(“status”).textContent =
    “Ruang ayat telah dikosongkan.”;
}


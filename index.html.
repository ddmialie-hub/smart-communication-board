* {
  box-sizing: border-box;
}

body {
  margin: 0;
  padding: 14px;
  font-family: Arial, sans-serif;
  background: #F8F6FC;
  color: #45415C;
}

header {
  background: linear-gradient(120deg, #DCD6F7, #CDEFE4);
  color: #45415C;
  text-align: center;
  padding: 16px;
  border-radius: 20px;
  margin-bottom: 12px;
}

header h1 {
  font-size: 25px;
  margin: 4px;
}

header p {
  margin: 6px 0;
}

h2 {
  font-size: 18px;
  margin: 12px 0 8px;
}

#sentence {
  background: #FFFFFF;
  border: 2px solid #DCD6F7;
  border-radius: 16px;
  min-height: 75px;
  padding: 12px;
  font-size: 21px;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.actions {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px;
  margin: 10px 0;
}

.action {
  min-height: 48px;
  border: 0;
  border-radius: 14px;
  padding: 9px 5px;
  background: #E3E9FA;
  color: #45415C;
  font-size: 14px;
  font-weight: bold;
}

#speak {
  background: #BFE8D9;
}

#categories {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding: 3px 0 8px;
  scroll-snap-type: x proximity;
}

.cat {
  flex: 0 0 112px;
  min-height: 58px;
  border: 2px solid transparent;
  border-radius: 14px;
  background: #E8E2FA;
  color: #45415C;
  font-size: 14px;
  font-weight: bold;
  scroll-snap-align: start;
}

.cat:nth-child(4n + 2) {
  background: #D4F0E6;
}

.cat:nth-child(4n + 3) {
  background: #FFE0E8;
}

.cat:nth-child(4n + 4) {
  background: #FFE9D2;
}

.cat.active {
  border-color: #8275B9;
  box-shadow: 0 2px 7px #B9B0D555;
}

#words {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 9px;
}

.tile {
  min-width: 0;
  min-height: 100px;
  border: 2px solid #E8E2F3;
  border-radius: 16px;
  background: #FFFFFF;
  color: #45415C;
  padding: 8px 4px;
  touch-action: manipulation;
  box-shadow: 0 2px 5px #6A638510;
}

.tile:nth-child(4n + 2) {
  background: #F0EDFF;
}

.tile:nth-child(4n + 3) {
  background: #E8F8F1;
}

.tile:nth-child(4n + 4) {
  background: #FFF0F3;
}

.tile:active {
  background: #DCD6F7;
  border-color: #A99DDA;
}

.symbol {
  display: block;
  font-size: 31px;
  margin-bottom: 6px;
}

.label {
  display: block;
  font-size: 14px;
  line-height: 1.25;
  font-weight: bold;
  overflow-wrap: anywhere;
}

#status {
  min-height: 18px;
  font-size: 13px;
}

footer {
  margin: 14px 0;
  text-align: center;
  font-size: 12px;
  color: #77718D;
}

/* Paparan melintang pada tablet */
@media (orientation: landscape) and (min-width: 600px) {
  body {
    padding: 10px 14px;
  }

  header {
    padding: 10px;
    margin-bottom: 8px;
  }

  header h1 {
    font-size: 22px;
  }

  header p {
    margin: 3px;
    font-size: 13px;
  }

  h2 {
    margin: 8px 0 5px;
    font-size: 16px;
  }

  #sentence {
    min-height: 58px;
    padding: 8px 12px;
    font-size: 19px;
  }

  .actions {
    margin: 7px 0;
  }

  .action {
    min-height: 40px;
  }

  #categories {
    gap: 7px;
  }

  .cat {
    flex-basis: 120px;
    min-height: 48px;
  }

  #words {
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 7px;
  }

  .tile {
    min-height: 86px;
    padding: 5px 3px;
  }

  .symbol {
    font-size: 29px;
    margin-bottom: 4px;
  }

  .label {
    font-size: 13px;
  }

  footer {
    margin: 8px 0;
  }
}
